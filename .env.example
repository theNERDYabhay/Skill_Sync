# Database & Cache Configuration
DATABASE_URL="postgresql://skillsync:skillsync_secure_password@localhost:5432/skillsync_production"
REDIS_URL="redis://:redis_secure_password@localhost:6379"

# Security & Authentication
JWT_SECRET="replace_with_a_secure_random_32_character_string"
SESSION_SECRET="replace_with_another_secure_session_secret"

# OAuth Integrations (Configured in respective provider consoles)
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# Object Storage (S3 / Cloudflare R2 / MinIO for resumes & avatars)
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_BUCKET="skillsync-resumes-prod"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your_s3_access_key_id"
S3_SECRET_KEY="your_s3_secret_access_key"

# ML Microservice
ML_SERVICE_URL="http://localhost:8000"

# Firebase Cloud Messaging (Mobile Push Notifications)
FCM_SERVER_KEY="your_fcm_server_key_or_service_account_path"
FIREBASE_PROJECT_ID="skillsync-mobile-push"

# AI Studio Injection Defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT="3000"
